# --- Supabase (optional for local avatar testing) ---
# If BOTH are set, middleware protects /tutor and /dashboard (sign-in required).
# Leave unset to try the tutor without auth, or set ALLOW_UNAUTH_TUTOR=true with Supabase on.
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# --- LiveAvatar FULL (POST /api/tutor/token) — server only ---
# LIVEAVATAR_API_KEY=
# LIVEAVATAR_AVATAR_ID=
# LIVEAVATAR_VOICE_ID=
# LIVEAVATAR_CONTEXT_ID=

# Supabase: profiles.subscription_status, children.parent_id, children.tutor_enabled
# Optional: service role for distributed rate limits (table tutor_liveavatar_requests)
# SUPABASE_SERVICE_ROLE_KEY=

# Stripe webhook (separate feature)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
