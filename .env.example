# Optional: ElevenLabs TTS for better read-aloud voice (Listen buttons).
# Get an API key at https://elevenlabs.io
# ELEVENLABS_API_KEY=your_api_key_here

# Optional: voice ID. Default is Bella (warm, friendly). Browse at elevenlabs.io/voice-library
# ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# Optional: more expressive = lower stability (0.3–0.5). Default 0.45 for energetic kid voice.
# ELEVENLABS_STABILITY=0.45
# ELEVENLABS_SIMILARITY_BOOST=0.8

# Optional: model (default: eleven_multilingual_v2)
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2
