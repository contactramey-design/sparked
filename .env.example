# =============================================================================
# LOCAL / VERCEL – copy into Vercel Project → Settings → Environment Variables
# =============================================================================

# --- Supabase (school pilots: teacher dashboard, class codes, generated units) ---
# VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJ...   # anon public key (Settings → API)

# Optional: ~60s school pilot demo (HeyGen embed, YouTube URL, or direct .mp4/.webm)
# VITE_SCHOOL_DEMO_VIDEO_URL=https://www.youtube.com/watch?v=YOUR_ID

# Required for Homework Adventure (process-homework): OpenAI vision + story
OPENAI_API_KEY=your_openai_key_here

# --- Stripe (Safety Pass + bundle entitlement; ebook checkout) ---
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_SAFETY_PASS_PRICE_ID=price_...
# STRIPE_CHECKOUT_SUCCESS_URL=https://yourdomain.com/?view=parent&checkout=success
# STRIPE_CHECKOUT_CANCEL_URL=https://yourdomain.com/?view=parent&checkout=cancel
# STRIPE_EBOOK_1_PRICE_ID=price_...
# (STRIPE_EBOOK_2_PRICE_ID … STRIPE_EBOOK_6_PRICE_ID as needed)

# Dev-only escape hatches (leave unset/false in production)
# ALLOW_UNAUTH_HOMEWORK=true   # Skip bundle checkout verification on /api/process-homework
# ALLOW_FREE_TEST_EBOOK=true # Allow ebook-1 download without Stripe (testing only)

# Optional: ElevenLabs TTS for Listen buttons and for video worker narration
# ELEVENLABS_API_KEY=your_api_key_here
# ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
# Optional: dedicated Spanish voice (Listen button sends locale=es from the app)
# ELEVENLABS_VOICE_ID_ES=your_spanish_voice_id
# ELEVENLABS_STABILITY=0.45
# ELEVENLABS_SIMILARITY_BOOST=0.8
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# Optional: ElevenLabs query param (see their docs); default mp3_44100_128
# ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128

# --- Video generation (worker on Render; free tier may cold-start ~30–60s) ---
# VIDEO_FEATURE_ENABLED=true
# VIDEO_WORKER_URL=https://your-worker.onrender.com
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx  # From Vercel Storage → Blob → Create token

# =============================================================================
# RAILWAY (worker only) – set in Railway → Your service → Variables
# Root Directory for the service must be: worker
# =============================================================================
# TTS_URL=https://YOUR_VERCEL_APP.vercel.app/api/tts
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx  # Same token as Vercel Blob
# ASSET_BASE_URL=https://YOUR_VERCEL_APP.vercel.app
