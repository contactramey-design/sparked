# =============================================================================
# LOCAL / VERCEL – copy into Vercel Project → Settings → Environment Variables
# =============================================================================
#
# Deploy checklist (tables + Supabase build-time notes): docs/DEPLOY-CHECKLIST.md
# Runtime probe (no secrets): GET /api/setup-status on your deployed origin
#
#
# --- Deploy without `vercel login` (when local CLI gets HTML instead of JSON) ---
# 1) Create token: https://vercel.com/account/tokens
# 2) GitHub: Repo → Settings → Secrets → Actions → add VERCEL_TOKEN → push main
#    triggers .github/workflows/vercel-production.yml
# 3) Local deploy: put VERCEL_TOKEN=... in .env.vercel.local (gitignored), then:
#    npm run deploy:vercel:token
#
# --- Git push when HTTPS fails ("could not read Username") ---
# Option A: brew install gh && gh auth login && git push origin main
# Option B: git remote set-url origin git@github.com:contactramey-design/sparked.git
#    (add SSH key at github.com/settings/keys) then git push origin main
#

# --- Supabase (school pilots: teacher dashboard, class codes, generated units) ---
# VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJ...   # anon public key (Settings → API)

# Optional: ~60s school pilot demo (HeyGen embed, YouTube URL, or direct .mp4/.webm)
# VITE_SCHOOL_DEMO_VIDEO_URL=https://www.youtube.com/watch?v=YOUR_ID

# Required for homework (analyze → explain → story) and Homework Adventure (process-homework): OpenAI
OPENAI_API_KEY=your_openai_key_here

# Optional: Pixar-style stills for homework story scenes (POST /api/generate-visuals, fal Flux 1.1 Pro)
# FAL_KEY=your_fal_api_key_here

# Optional: Vercel Cron auth — set in Vercel → Settings → Environment Variables (same value as Vercel Cron "Secret").
# When set, GET /api/cron/cleanup-adventure-videos must send Authorization: Bearer <CRON_SECRET> (Vercel does this automatically).
# CRON_SECRET=long_random_string

# --- Stripe (Adventure Academy subscription; per-ebook one-time checkout) ---
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_ACADEMY_PRICE_ID=price_...   # Adventure Academy (tutor + Homework Adventure + full practice + subscriber PDFs)
# STRIPE_CHECKOUT_SUCCESS_URL=https://yourdomain.com/?view=parent&checkout=success
# STRIPE_CHECKOUT_CANCEL_URL=https://yourdomain.com/?view=parent&checkout=cancel
# STRIPE_EBOOK_1_PRICE_ID=price_...
# (STRIPE_EBOOK_2_PRICE_ID … STRIPE_EBOOK_6_PRICE_ID as needed)

# --- AI Tutor Academy (/ai-tutor): GPT-4o chat + LiveAvatar + ElevenLabs voice ---
# Architecture map (routes, COPPA, SDK contract): docs/AI-TUTOR-ARCHITECTURE.md
# Uses same OPENAI_API_KEY and Stripe entitlement as homework (Adventure Academy checkout session).
# Live video: POST /api/liveavatar-session → api.liveavatar.com (client: @heygen/liveavatar-web-sdk).
# LIVEAVATAR_API_KEY=...                # Preferred; LiveAvatar dashboard API key
# LIVEAVATAR_AVATAR_ID=                 # Real avatar UUID (not "default")
# LIVEAVATAR_VOICE_ID=                  # For FULL mode (or use HEYGEN_TUTOR_VOICE_ID)
# LIVEAVATAR_VOICE_ID_ES=              # Optional Spanish voice when app locale is ES (or HEYGEN_TUTOR_VOICE_ID_ES)
# LIVEAVATAR_CONTEXT_ID=                # For FULL mode — required with voice for FULL; omit for LITE
# HEYGEN_API_KEY=...                    # Optional fallback if LIVEAVATAR_API_KEY unset (same key may work post-migration)
# HEYGEN_TUTOR_AVATAR_ID=               # Fallback avatar id if LIVEAVATAR_AVATAR_ID unset
# HEYGEN_TUTOR_VOICE_ID=                # Fallback voice id for FULL if LIVEAVATAR_VOICE_ID unset
# ELEVENLABS_API_KEY also powers POST /api/tts-stream (same voices as /api/tts)

# Dev-only escape hatches (leave unset/false in production)
# ALLOW_UNAUTH_HOMEWORK=true   # Skip Stripe on /api/process-homework and /api/homework/*; GET /api/config returns homeworkAllowUnauth so the app allows upload without Academy checkout. Use for local dev or OpenAI-only staging — not for public prod without other gates.
# HOMEWORK_REQUIRE_CHECKOUT=true  # When set, homework APIs + upload paywall require a valid Stripe checkout session (unless ALLOW_UNAUTH_HOMEWORK). Unset/false matches default open behavior like AI_TUTOR_REQUIRE_CHECKOUT.
# ALLOW_UNAUTH_TUTOR=true      # Skip Stripe on /api/tutor-chat, /api/liveavatar-session (local dev only)
# AI_TUTOR_REQUIRE_CHECKOUT=true  # Optional: sets GET /api/config aiTutorRequireCheckout. Text chat always allows 3 free user messages first (tutor-chat); live video still requires Academy unless ALLOW_UNAUTH_TUTOR.
# HOMEWORK_ADVENTURE_PAUSED=true  # 503 on Homework Adventure Video APIs (Claude + adventure TTS + generate-adventure-video); UI shows “paused”. Omit/false = adventure video available.

# --- AI Tutor lead capture (/api/tutor-lead, “3 more free messages” modal on /ai-tutor) ---
# Set one path (or both). GET /api/config exposes tutorLeadCaptureEnabled when configured.
# Resend: https://resend.com — verify sending domain; “from” must be allowed in Resend.
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=Sparki <hello@yourdomain.com>
# TUTOR_LEAD_NOTIFY_TO=you@yourdomain.com
# Optional: POST JSON { source, email, locale, at } to Zapier/Make/Airtable (optional Bearer).
# TUTOR_LEAD_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/...
# TUTOR_LEAD_WEBHOOK_SECRET=optional_shared_secret
# ALLOW_FREE_TEST_EBOOK=true # Allow ebook-1 download without Stripe (testing only)

# Optional: ElevenLabs TTS for Listen buttons and for video worker narration
# ELEVENLABS_API_KEY=your_api_key_here
# ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
# Optional: dedicated Spanish voice (Listen button sends locale=es from the app)
# ELEVENLABS_VOICE_ID_ES=your_spanish_voice_id
# ELEVENLABS_STABILITY=0.45
# ELEVENLABS_SIMILARITY_BOOST=0.8
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# Optional: ElevenLabs query param (see their docs); default mp3_44100_128
# ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128

# --- Video generation (worker on Render; free tier may cold-start ~30–60s) ---
# VIDEO_FEATURE_ENABLED=true
# VIDEO_WORKER_URL=https://your-worker.onrender.com
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx  # From Vercel Storage → Blob → Create token
#
# Shared secret: Vercel → worker POST /generate and worker → /api/tts (Bearer). Strongly recommended in production.
# SPARKI_SERVICE_SECRET=long_random_string
# Comma-separated exact origins for browser Listen (/api/tts), e.g. https://www.yoursite.com,https://yoursite.vercel.app
# TTS_ALLOW_ORIGINS=https://www.example.com

# =============================================================================
# RAILWAY (worker only) – set in Railway → Your service → Variables
# Root Directory for the service must be: worker
# =============================================================================
# TTS_URL=https://YOUR_VERCEL_APP.vercel.app/api/tts
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx  # Same token as Vercel Blob
# ASSET_BASE_URL=https://YOUR_VERCEL_APP.vercel.app
# SPARKI_SERVICE_SECRET=long_random_string  # Same value as on Vercel
